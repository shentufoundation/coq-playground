{
    "version": 2,

    "routes": [
        {
            "src": "/coq-pkgs/openmath\\.(.*)",
            "dest": "https://img.shentu.org/math/openmath.$1",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/node_modules/(.*)",
            "dest": "/addons/$1",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/(.*\\.(js|css|png|svg|cjs|gif|html|json|coq-pkg))",
            "dest": "/$1",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/",
            "dest": "/playground.html",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        }
    ]
}
