{
    "version": 2,
    "routes": [
        {
            "src": "/(.*\\.(js|css|png|svg|cjs|gif|html))",
            "dest": "/$1",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/node_modules/@jscoq/(.*)",
            "dest": "/node_modules/@jscoq/$1",
            "headers": {
              "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/(coq-pkgs|docs)/(.*)",
            "dest": "/$1/$2",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        },
        {
            "src": "/",
            "dest": "/playground.html",
            "headers": {
                "Access-Control-Allow-Origin": "*"
            }
        }
    ]
}
